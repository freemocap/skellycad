# CAD sources, releases and historical evidence are stored through Git LFS.
# Preserve byte-level hashes in frozen checkpoints and camera design records.
**/checkpoints/** -text eol=lf
designs/cameras/ov9281/** -text
designs/cameras/og0tc/** -text
*.FCStd filter=lfs diff=lfs merge=lfs -text
*.fcstd filter=lfs diff=lfs merge=lfs -text
*.f3d filter=lfs diff=lfs merge=lfs -text
*.F3D filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.step filter=lfs diff=lfs merge=lfs -text
*.STEP filter=lfs diff=lfs merge=lfs -text
*.brep filter=lfs diff=lfs merge=lfs -text
*.brp filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Bounded-size volumes of the immutable cleanup retention archives.
*.zip.[0-9][0-9][0-9] filter=lfs diff=lfs merge=lfs -text
designs/ultraskelly/references/** -text
