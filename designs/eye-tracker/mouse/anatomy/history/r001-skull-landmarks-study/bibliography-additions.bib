@article{maga2017MouseSkullAtlas,
 author = {Maga, A. Murat and Tustison, Nicholas J. and Avants, Brian B.},
 title = {A population level atlas of {Mus musculus} craniofacial skeleton and automated image-based shape analysis},
 journal = {Journal of Anatomy}, year = {2017}, volume = {231}, pages = {433--443},
 doi = {10.1111/joa.12645}, url = {https://onlinelibrary.wiley.com/doi/full/10.1111/joa.12645},
 urldate = {2026-10-14}, review = {excerpt},
 claim = {A synthetic mouse craniofacial template has segmented cranium and anatomical landmark coordinates suitable for exploratory CAD import and registration.},
 note = {Reviewed abstract, imaging, segmentation, landmark-transfer methods and results. The template cohort comprises 8-week-old females from 25 inbred strains and five F1 crosses; it is not an adult-male median. The author landmark-definition supplement was not successfully retrieved, so this study keeps source numeric IDs and marks interpreted names tentative.}
}
